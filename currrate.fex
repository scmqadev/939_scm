ENGINE INT CACHE SET ON
SET PAGE-NUM=NOLEAD
SET SQUEEZE=ON
-DEFAULTH &WF_HTMLENCODE=ON;
SET HTMLENCODE=&WF_HTMLENCODE

SET HTMLCSS=ON
-DEFAULTH &WF_EMPTYREPORT=ON;
SET EMPTYREPORT=&WF_EMPTYREPORT

-DEFAULTH &WF_EMBEDHEADING=ON;
SET EMBEDHEADING=&WF_EMBEDHEADING

SET GRAPHDEFAULT=OFF
-DEFAULTH &WF_UNITS=INCHES;
SET UNITS=&WF_UNITS

-DEFAULTH &WF_SUMMARY='Summary';
-DEFAULTH &WF_TITLE='WebFOCUS Report';

*-SKIP-HOLD-TEXT-START-DATA
-*DM_USERID=admin
-*DM_CLIENT_RELEASE_GEN=M729300D_2999
-*DM_SERVER_RELEASE_GEN=M729300D_2999
-*DM_LAST_MODIFIED=20260303 17.07.08
-:START_PRC
SET PANEL=9999
SET MORE=OFF
SET 2PARTNAME=ON
-RUN
-*[Variables to Control Request]
-SET &&CM__TARGET = 'wf_retail_currency';
-SET &&CM__AUTHOR = 'admin';
-SET &&CM__REQUEST = '&FOCFEXNAME.EVAL';
-SET &&CM__RETURN = 0;
-SET &&CM__FOCCPU = &FOCCPU.EVAL;
-TYPE  (ICM18122) Request - &FOCFEXNAME (Owner: admin) submitted.
-GOTO :DEP_MAIN
-:DEP_MAIN
-TYPE  (ICM18741) foccache/t2026062170708/wf_retail_currency type SQL_SCRIPT New target
SQL SET UPCASE OFF;
END
-TYPE  (ICM18743) Starting Load
SQL 
SELECT 
   T1.CURRENCY_NAME ,  
   T1.CURRENCY_RATE  
FROM 
   "retail_demo/dimensions".wf_retail_currency T1  
 
; 
TABLE
ON TABLE SET PAGE NOPAGE
ON TABLE SET HOLDATTRS CUBE
ON TABLE SET HOLDLIST NOFOCLIST
ON TABLE SET EMPTYREPORT ON
ON TABLE SET SHORTPATH SQL
ON TABLE SET ACROSSPRT COMPRESS
ON TABLE SET ASNAMES MIXED
ON TABLE HOLD
 NOKEYS AS
foccache/t2026062170708/wf_retail_currency
FORMAT SQL_SCRIPT
NOEXPR *
END
-RUN
-SET &&CM__RETURN = &FOCERRNUM;
-TYPE  (ICM18744) Ending Load
-RUN
-IF (&&CM__RETURN NE 0) GOTO :ENDJOB;
-IF (&SQLAPT EQ 'APT') GOTO :SKIPHOLD;
-TYPE  (ICM18440) Request will process data via NON-Pass Through (NON-APT)
-:SKIPHOLD
-:ENDJOB
-TYPE  (ICM18040) Return Code = &&CM__RETURN
SQL SET UPCASE ON;
END
SET PANEL=0
SET MORE=ON
SET 2PARTNAME=OFF
-RUN
-TYPE  (ICM18076) Request: &FOCFEXNAME - finished processing
-SET &&CM__FOCCPU = &FOCCPU.EVAL - &&CM__FOCCPU;
-TYPE  (ICM18007) CPU Time : &&CM__FOCCPU
-*[Main Condition]
-GOTO :ENDDEP
-*[Main End]
-*[Dependence]
-:ENDDEP
-RUN

*-SKIP-HOLD-TEXT-END-DATA

SET ARVERSION=2
-DEFAULTH &WF_SUMMARY='Summary';
-DEFAULTH &WF_TITLE='WebFOCUS Report';
TABLE FILE foccache/t2026062170708/wf_retail_currency
PRINT wf_retail_currency.WF_RETAIL_CURRENCY.CURRENCY_NAME
wf_retail_currency.WF_RETAIL_CURRENCY.CURRENCY_RATE
HEADING
"Currency Rate BY Currency Name Currency Name "
ON TABLE PCHOLD FORMAT HTML
ON TABLE NOTOTAL
ON TABLE SET POPUPDESC ON
ON TABLE SET CACHELINES 100
ON TABLE SET HTMLCSS ON
ON TABLE SET SHORTPATH SQL
ON TABLE SET HTMLENCODE ON
ON TABLE SET PAGE NOPAGE
ON TABLE SET EMPTYREPORT ON
ON TABLE SET STYLE *
INCLUDE=IBFS:/WFC/Global/Themes/Standard/Default/theme.sty,$
TYPE=REPORT, TITLETEXT=&WF_TITLE.QUOTEDSTRING, SUMMARY=&WF_SUMMARY.QUOTEDSTRING, ARREPORTSIZE=DIMENSION, ARFILTER_TARGET='*', ARGRAPHENGINE=JSCHART, $
ENDSTYLE
END

